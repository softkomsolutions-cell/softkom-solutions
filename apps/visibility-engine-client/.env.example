DATABASE_URL=postgresql://visibility:replace-me@localhost:5433/visibility
BETTER_AUTH_URL=http://localhost:3000
# Generate at least 32 random bytes; never commit actual secrets.
BETTER_AUTH_SECRET=
# Base64-encoded 32-byte AES key for external provider credential storage.
CONNECTION_ENCRYPTION_KEY=

# Google OAuth: configure this exact callback URL in Google Cloud Console.
# Enable Search Console API; request webmasters.readonly scope, offline consent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/connections/google/callback

# Server-to-server intake secrets. Generate long random values and never expose
# them to browser code.
ATTRIBUTION_WEBHOOK_SECRET=
AI_OBSERVATION_WEBHOOK_SECRET=


# AI visibility monitoring. Mistral is the default provider.
AI_VISIBILITY_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_VISIBILITY_MODEL=mistral-small-2603

# Optional fallback provider.
OPENAI_API_KEY=

# Commercial packaging / checkout. Leave blank to use managed Softkom invoicing
# and manual plan activation from the admin console.
BILLING_STARTER_URL=
BILLING_GROWTH_URL=
BILLING_PRO_URL=
BILLING_WEBHOOK_SECRET=

# Comma-separated operator emails allowed to manage paid plan activation.
SOFTKOM_ADMIN_EMAILS=
