generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     Membership[]
  sites     Site[]
  plan      Subscription?
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orgs      Membership[]
}

model Membership {
  id             String       @id @default(cuid())
  role           OrgRole      @default(CLIENT)
  organisationId String
  userId         String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
}

enum OrgRole {
  OWNER
  ADMIN
  CLIENT
  SOFTKOM_MANAGER
}

model Site {
  id             String       @id @default(cuid())
  organisationId String
  name           String
  baseUrl        String
  cms            CmsType      @default(WORDPRESS)
  status         SiteStatus   @default(DISCONNECTED)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  topics         Topic[]
  content        ContentItem[]
  publications   Publication[]
  metrics        SearchMetric[]
  leads          LeadAttribution[]
}

enum CmsType {
  WORDPRESS
  SHOPIFY
  WEBFLOW
  OTHER
}

enum SiteStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

model Topic {
  id         String      @id @default(cuid())
  siteId     String
  title      String
  slug       String
  cluster    String
  intent     SearchIntent
  priority   Int         @default(0)
  status     TopicStatus @default(RESEARCH)
  funnel     String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  site       Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  content    ContentItem[]

  @@unique([siteId, slug])
}

enum SearchIntent {
  COMMERCIAL
  LOCAL_COMMERCIAL
  DECISION_SUPPORT
  INFORMATIONAL
  PROBLEM_AWARENESS
}

enum TopicStatus {
  RESEARCH
  PLANNED
  WRITING
  REVIEW
  APPROVED
  PUBLISHED
  PAUSED
}

model ContentItem {
  id          String        @id @default(cuid())
  siteId      String
  topicId     String?
  title       String
  slug        String
  body        String        @db.Text
  metaTitle   String?
  metaDesc    String?
  status      ContentStatus @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  site        Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  topic       Topic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  approvals   Approval[]
  publications Publication[]
}

enum ContentStatus {
  DRAFT
  CLIENT_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Approval {
  id          String      @id @default(cuid())
  contentId   String
  reviewerId  String?
  decision    ApprovalDecision
  comment     String?
  createdAt   DateTime    @default(now())
  content     ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

enum ApprovalDecision {
  APPROVED
  CHANGES_REQUESTED
}

model Publication {
  id          String      @id @default(cuid())
  siteId      String
  contentId   String
  provider    CmsType
  externalId  String?
  liveUrl     String?
  status      PublishStatus @default(PENDING)
  error       String?
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  site        Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  content     ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

enum PublishStatus {
  PENDING
  PUBLISHING
  LIVE
  FAILED
}

model SearchMetric {
  id          String   @id @default(cuid())
  siteId      String
  date        DateTime
  query       String?
  pageUrl     String?
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float?
  source      MetricSource
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, date])
}

enum MetricSource {
  GOOGLE_SEARCH_CONSOLE
  BING
  AI_VISIBILITY
  MANUAL
}

model LeadAttribution {
  id          String   @id @default(cuid())
  siteId      String
  landingUrl  String
  source      String?
  medium      String?
  campaign    String?
  funnel      String?
  leadId      String?
  revenue     Decimal? @db.Decimal(12,2)
  createdAt   DateTime @default(now())
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Subscription {
  id             String       @id @default(cuid())
  organisationId String       @unique
  plan           String
  status         String
  monthlyPrice   Decimal      @db.Decimal(12,2)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}
