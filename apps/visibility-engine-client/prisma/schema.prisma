generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisation {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           Membership[]
  sites           Site[]
  auditEvents     AuditEvent[]
  businessProfile BusinessProfile?
  plan            Subscription?
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  emailVerified Boolean          @default(false)
  image         String?
  sessions      Session[]
  accounts      Account[]
  approvals     Approval[]
  comments      ContentComment[]
  orgs          Membership[]
}

model Membership {
  id             String       @id @default(cuid())
  role           OrgRole      @default(CLIENT)
  organisationId String
  userId         String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
}

enum OrgRole {
  OWNER
  ADMIN
  CLIENT
  SOFTKOM_MANAGER
}

model Site {
  id             String            @id @default(cuid())
  organisationId String
  name           String
  baseUrl        String
  cms            CmsType           @default(WORDPRESS)
  status         SiteStatus        @default(DISCONNECTED)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  topics         Topic[]
  content        ContentItem[]
  publications   Publication[]
  metrics        SearchMetric[]
  connections    SiteConnection[]
  aiObservations AIObservation[]
  leads          LeadAttribution[]
}

enum CmsType {
  WORDPRESS
  SHOPIFY
  WEBFLOW
  OTHER
}

enum SiteStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

model Topic {
  id              String        @id @default(cuid())
  siteId          String
  title           String
  slug            String
  cluster         String
  intent          SearchIntent
  priority        Int           @default(0)
  status          TopicStatus   @default(RESEARCH)
  funnel          String?
  reasoning       String        @default("") @db.Text
  businessProblem String        @default("")
  contentType     String        @default("Commercial problem page")
  evidence        String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  site            Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  content         ContentItem[]

  @@unique([siteId, slug])
  @@unique([id, siteId])
}

enum SearchIntent {
  COMMERCIAL
  LOCAL_COMMERCIAL
  DECISION_SUPPORT
  INFORMATIONAL
  PROBLEM_AWARENESS
}

enum TopicStatus {
  RESEARCH
  PLANNED
  WRITING
  REVIEW
  APPROVED
  PUBLISHED
  PAUSED
}

model ContentItem {
  id                    String            @id @default(cuid())
  siteId                String
  topicId               String?
  title                 String
  slug                  String
  body                  String            @db.Text
  metaTitle             String?
  metaDesc              String?
  status                ContentStatus     @default(DRAFT)
  scheduledAt           DateTime?
  publishedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  site                  Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  topic                 Topic?            @relation(fields: [topicId, siteId], references: [id, siteId], onDelete: NoAction)
  contentType           String            @default("Commercial problem page")
  funnel                String?
  reviewerId            String?
  internalLinks         String            @default("") @db.Text
  publishingDestination String            @default("WordPress draft")
  revision              Int               @default(1)
  revisions             ContentRevision[]
  comments              ContentComment[]
  leads                 LeadAttribution[]
  approvals             Approval[]
  publications          Publication[]

  @@unique([id, siteId])
  @@index([siteId, scheduledAt])
}

enum ContentStatus {
  DRAFT
  CLIENT_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Approval {
  id         String           @id @default(cuid())
  contentId  String
  reviewerId String?
  revision   Int              @default(1)
  reviewer   User?            @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  decision   ApprovalDecision
  comment    String?
  createdAt  DateTime         @default(now())
  content    ContentItem      @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

enum ApprovalDecision {
  APPROVED
  CHANGES_REQUESTED
}

model Publication {
  id                String        @id @default(cuid())
  siteId            String
  contentId         String
  provider          CmsType
  externalId        String?
  liveUrl           String?
  status            PublishStatus @default(PENDING)
  error             String?
  attempts          Int           @default(0)
  requestedRevision Int           @default(1)
  overrideReason    String?
  requestedBy       String?
  providerResponse  Json?
  nextRetryAt       DateTime?
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  site              Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  content           ContentItem   @relation(fields: [contentId, siteId], references: [id, siteId], onDelete: Cascade)
}

enum PublishStatus {
  PENDING
  PUBLISHING
  LIVE
  FAILED
}

model SearchMetric {
  id          String       @id @default(cuid())
  siteId      String
  date        DateTime
  query       String?
  pageUrl     String?
  clicks      Int          @default(0)
  impressions Int          @default(0)
  ctr         Float        @default(0)
  position    Float?
  source      MetricSource
  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, date])
}

enum MetricSource {
  GOOGLE_SEARCH_CONSOLE
  BING
  AI_VISIBILITY
  MANUAL
}

model LeadAttribution {
  id         String       @id @default(cuid())
  siteId     String
  landingUrl String
  source     String?
  medium     String?
  campaign   String?
  funnel     String?
  leadId     String?
  contentId  String?
  content    ContentItem? @relation(fields: [contentId, siteId], references: [id, siteId], onDelete: NoAction)
  cluster    String?
  stage      LeadStage    @default(LEAD)
  dataOrigin DataOrigin   @default(MANUAL)
  currency   String       @default("ZAR")
  revenue    Decimal?     @db.Decimal(12, 2)
  createdAt  DateTime     @default(now())
  site       Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Subscription {
  id             String       @id @default(cuid())
  organisationId String       @unique
  plan           String
  status         String
  monthlyPrice   Decimal      @db.Decimal(12, 2)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model BusinessProfile {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  services       String       @db.Text
  customers      String       @db.Text
  market         String
  conversionGoal String
  completedAt    DateTime     @default(now())
}

model ContentRevision {
  id            String      @id @default(cuid())
  contentId     String
  content       ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  number        Int
  title         String
  body          String      @db.Text
  metaTitle     String?
  metaDesc      String?
  internalLinks String      @default("")
  authorId      String
  createdAt     DateTime    @default(now())

  @@unique([contentId, number])
}

model ContentComment {
  id        String      @id @default(cuid())
  contentId String
  content   ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  revision  Int
  body      String      @db.Text
  createdAt DateTime    @default(now())
}

model AuditEvent {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actorId        String
  action         String
  entityId       String
  detail         Json?
  createdAt      DateTime     @default(now())

  @@index([organisationId, createdAt])
}

model SiteConnection {
  id                   String             @id @default(cuid())
  siteId               String
  site                 Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  provider             ConnectionProvider
  status               ConnectionState    @default(NOT_CONNECTED)
  encryptedCredentials String?            @db.Text
  lastSyncedAt         DateTime?
  error                String?
  updatedAt            DateTime           @updatedAt

  @@unique([siteId, provider])
}

enum ConnectionProvider {
  WORDPRESS
  GOOGLE_SEARCH_CONSOLE
  GOOGLE_ANALYTICS_4
}

enum ConnectionState {
  NOT_CONNECTED
  COMING_SOON
  REQUIRES_SETUP
  CONNECTED
  ERROR
}

model AIObservation {
  id                  String   @id @default(cuid())
  siteId              String
  site                Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  platform            String
  prompt              String   @db.Text
  brandMentioned      Boolean
  pageCited           Boolean
  citationUrl         String?
  competitorMentioned String?
  observedAt          DateTime
  confidence          String
  source              String

  @@index([siteId, observedAt])
}

enum LeadStage {
  LEAD
  QUALIFIED
  OPPORTUNITY
  WON
  LOST
}

enum DataOrigin {
  MANUAL
  IMPORTED
  CRM
}
