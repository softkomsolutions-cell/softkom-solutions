FROM mcr.microsoft.com/playwright:v1.64.1-noble

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY prisma ./prisma
RUN npm run db:generate

COPY . .
ENV BETTER_AUTH_URL=http://localhost:3000
ENV BETTER_AUTH_SECRET=validator-build-only-secret-not-used-for-staging-users
RUN npm run build

ENV NODE_ENV=test
ENV NEXT_TELEMETRY_DISABLED=1

CMD ["npm", "run", "test:browser", "--", "tests/browser/workflow.spec.ts"]
